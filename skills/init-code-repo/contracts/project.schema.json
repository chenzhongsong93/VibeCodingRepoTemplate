{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Harness project v2",
  "type": "object",
  "required": [
    "schemaVersion",
    "nodeMinimum",
    "templateRevision",
    "capabilities",
    "documents",
    "checks",
    "workflow",
    "stacks",
    "worktree"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "nodeMinimum": {
      "const": 22
    },
    "templateRevision": {
      "type": "string"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "documents": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "profiles",
          "required"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "builtin",
              "command"
            ]
          },
          "profiles": {
            "type": "array",
            "items": {
              "enum": [
                "fast",
                "ci",
                "release"
              ]
            }
          },
          "required": {
            "type": "boolean"
          },
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "inputSelection": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "excludeDirectoryNames", "excludePaths"],
            "properties": {
              "kind": {"const": "python-files"},
              "excludeDirectoryNames": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "excludePaths": {"type": "array", "items": {"type": "string", "minLength": 1}}
            }
          },
          "cwd": {
            "type": "string"
          },
          "timeoutSeconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "effect": {
            "enum": ["local-validation", "real-e2e"]
          },
          "tools": {
            "type": "array",
            "items": {"type": "string"}
          },
          "layer": {
            "enum": [
              "L1",
              "L2",
              "L3"
            ]
          }
        },
        "allOf": [
          {
            "if": {"properties": {"kind": {"const": "command"}}},
            "then": {"required": ["argv", "timeoutSeconds", "effect"]}
          }
        ]
      }
    },
    "workflow": {
      "type": "object",
      "properties": {
        "stages": {
          "const": [
            "orient",
            "specify",
            "design",
            "analyze",
            "implement",
            "verify",
            "converge",
            "handover"
          ]
        }
      },
      "required": [
        "version",
        "stages"
      ]
    },
    "ci": {
      "type": "object",
      "properties": {
        "bootstrap": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "argv",
              "cwd"
            ],
            "properties": {
              "argv": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "cwd": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
