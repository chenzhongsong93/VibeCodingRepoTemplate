{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Harness task v2",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "stage",
    "status",
    "scope",
    "risk",
    "impact",
    "criteriaRefs",
    "approvalRefs",
    "verificationRefs",
    "nextActions",
    "domainRefs",
    "criteriaResults",
    "convergence"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^TASK-[0-9]{8}-[a-f0-9-]{36}$"
    },
    "stage": {
      "enum": [
        "orient",
        "specify",
        "design",
        "analyze",
        "implement",
        "verify",
        "converge",
        "handover"
      ]
    },
    "status": {
      "enum": [
        "in-progress",
        "blocked",
        "done",
        "cancelled"
      ]
    },
    "risk": {
      "type": [
        "object",
        "null"
      ]
    },
    "impact": {
      "type": "object"
    },
    "domainRefs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "criteriaRefs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "path"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
          },
          "path": {
            "type": "string"
          }
        }
      }
    },
    "criteriaResults": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "checkIds"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "blocked",
              "not-run"
            ]
          },
          "checkIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "convergence": {
      "type": [
        "object",
        "null"
      ],
      "description": "初始化为null；完整收敛须有实际内容审查和全部受影响owner，字段不证明语义真实性。",
      "required": [
        "review",
        "owners"
      ],
      "properties": {
        "review": {
          "type": "object",
          "required": [
            "kind",
            "source",
            "summary",
            "status",
            "findings"
          ],
          "properties": {
            "kind": {
              "enum": [
                "self",
                "independent",
                "human"
              ]
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "enum": [
                "pass",
                "fail",
                "blocked"
              ]
            },
            "findings": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/finding"
              }
            }
          }
        },
        "owners": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "outcome",
              "reason",
              "evidenceRefs"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "outcome": {
                "enum": [
                  "updated",
                  "reviewed-unchanged"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "evidenceRefs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "openItems": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        }
      }
    }
  },
  "$defs": {
    "transfer": {
      "type": "object",
      "required": [
        "path",
        "id",
        "closureCriteria"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "closureCriteria": {
          "type": "string",
          "minLength": 1
        }
      },
      "description": "真实共享正式owner中的条目与关闭条件；本地路径不构成承接。"
    },
    "finding": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string"
        },
        "blocking": {
          "type": "boolean"
        },
        "transfer": {
          "$ref": "#/$defs/transfer"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "blocking": {
                "const": false
              },
              "status": {
                "not": {
                  "const": "closed"
                }
              }
            },
            "required": [
              "blocking"
            ]
          },
          "then": {
            "required": [
              "id",
              "status",
              "transfer"
            ]
          }
        }
      ]
    }
  }
}
