{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Managed local asset retention policy",
  "type": "object",
  "required": ["schemaVersion", "enabled"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": 1},
    "enabled": {"type": "boolean", "default": false},
    "workDays": {"type": "number", "minimum": 0, "maximum": 36500, "default": 7},
    "runDays": {"type": "number", "minimum": 0, "maximum": 36500, "default": 30},
    "cacheDays": {"type": "number", "minimum": 0, "maximum": 36500, "default": 14},
    "quarantineDays": {"type": "number", "minimum": 0, "maximum": 36500, "default": 7},
    "planHours": {"type": "number", "minimum": 0, "maximum": 36500, "default": 24},
    "auditDays": {"type": "number", "minimum": 0, "maximum": 36500, "default": 90},
    "cacheMaxBytes": {"type": "number", "minimum": 0, "default": 1073741824}
  }
}
